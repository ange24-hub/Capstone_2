APP_NAME="SB-ISPGM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR_DOMAIN
# Absolute domain document root on cPanel, e.g. /home/ACCOUNT/public_html.
APP_PUBLIC_PATH=

BARANGAY_REGISTRATION_CODE=
MUNICIPAL_LGU_REGISTRATION_CODE=

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=sbispgm_session

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SB-ISPGM"

DOCUMENT_FEE_INDIGENCY=0
DOCUMENT_FEE_CLEARANCE=0
DOCUMENT_FEE_RESIDENCY=0
DOCUMENT_FEE_BUSINESS_CLEARANCE=0

LOCAL_AI_ENABLED=false
LOCAL_AI_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen2.5:1.5b
LOCAL_AI_TIMEOUT=25
MIGRATION_PREDICTION_ENABLED=false
MIGRATION_PREDICTION_URL=http://127.0.0.1:5001
