xt": "USE CASE DIAGRAM", "size": 47, "bold": true}, {"x": 1300, "y": 118, "text": "SB-ISPGM / RBIM | Municipality of Tomas Oppus", "size": 29, "bold": false}, {"x": 1300, "y": 163, "text": "Core business functions and authorized user roles", "size": 25, "bold": false}, {"x": 1325, "y": 260, "text": "SB-ISPGM System", "size": 31, "bold": true}, {"x": 900, "y": 330, "text": "RESIDENT SERVICES", "size": 23, "bold": true}, {"x": 1750, "y": 330, "text": "MUNICIPAL FUNCTIONS", "size": 23, "bold": true}, {"x": 900, "y": 1310, "text": "BARANGAY OPERATIONS", "size": 23, "bold": true}, {"x": 1750, "y": 1150, "text": "SHARED STAFF FUNCTIONS", "size": 23, "bold": true}, {"x": 200, "y": 903, "text": "Resident", "size": 29, "bold": true}, {"x": 200, "y": 2063, "text": "Barangay\nSecretary", "size": 29, "bold": true}, {"x": 2400, "y": 1183, "text": "Municipal\nDILG User", "size": 29, "bold": true}, {"x": 1750, "y": 2025, "text": "ACCESS CONDITIONS", "size": 24, "bold": true}, {"x": 1750, "y": 2110, "text": "Protected functions require authentication\nand the appropriate role and record scope.", "size": 26, "bold": false}, {"x": 1750, "y": 2220, "text": "Resident and Secretary accounts\nrequire approval before accessing services.", "size": 26, "bold": false}, {"x": 1750, "y": 2330, "text": "Forecasts require sufficient verified\nmonthly migration history.", "size": 26, "bold": false}, {"x": 1300, "y": 2650, "text": "Stick figure = actor   |   Oval = use case   |   Solid line = association   |   Rectangle = system boundary", "size": 25, "bold": false}, {"x": 1300, "y": 2700, "text": "Associations show permitted participation, not execution order or data movement.", "size": 24, "bold": false}, {"x": 1300, "y": 2745, "text": "Common registration, login, logout and password-recovery interactions are omitted to focus on business functions.", "size": 23, "bold": false}]}