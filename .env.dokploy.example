# Paste into Dokploy's Compose Environment tab and replace every placeholder.
# Keep real credentials out of Git. This is separate from the Laragon .env.
APP_NAME="SB-ISPGM"
APP_URL=https://YOUR_DOMAIN
APP_KEY=
TRUSTED_PROXIES=*

DB_DATABASE=sbispgm
DB_USERNAME=sbispgm
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Use different random values of at least 24 characters.
BARANGAY_REGISTRATION_CODE=
MUNICIPAL_LGU_REGISTRATION_CODE=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=

LOG_LEVEL=warning
SESSION_LIFETIME=30
SESSION_COOKIE=sbispgm_session
RUN_MIGRATIONS=false

DOCUMENT_FEE_INDIGENCY=0
DOCUMENT_FEE_CLEARANCE=0
DOCUMENT_FEE_RESIDENCY=0
DOCUMENT_FEE_BUSINESS_CLEARANCE=0

# Optional self-hosted chatbot. Enable both values after checking VPS capacity.
# See docs/dokploy-deployment.md for the one-time model download.
COMPOSE_PROFILES=ai
ASSISTANT_AI_ENABLED=true
ASSISTANT_AI_MODEL=qwen2.5:1.5b
ASSISTANT_AI_TIMEOUT=20
OLLAMA_CPUS=2
OLLAMA_MEMORY_LIMIT=3g
